# .env.example
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub — only commit this example file.

# UniFi Console
UNIFI_CONSOLE_IP=192.168.1.1
UNIFI_API_KEY=
UNIFI_SITE_ID=                          # leave blank until you run --discover

# Local LLM (LM Studio default port)
LLM_ENDPOINT=http://localhost:1234/v1/chat/completions
LLM_MODEL=                              # exact model name from LM Studio

# Where to save daily reports
# Windows: M:/security_reports
# Ubuntu:  /mnt/models/security_reports
REPORT_DIR=M:/security_reports
